# CONTRACT ZERO API (Rust / Actix): copy to .env and fill in. Never commit .env.

# Postgres connection string (required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contract_zero

# Bind address (default 0.0.0.0:8080) and log level (default info).
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Extra comma-separated CORS origins. http://localhost:* is always allowed.
FRONTEND_ORIGIN=

# World clock: real seconds per in-game hour, agent cadence in ticks, genesis seed.
WORLD_TICK_SECS=60
AGENT_EVERY_TICKS=1
WORLD_SEED=2026
# Start from the acceptance-test state instead of genesis (fresh database only).
WORLD_SCENARIO=

# Optional error reporting.
SENTRY_DSN=

# NEAR settlement. OFF by default: with CZ_WORLD unset the whole game runs off-chain
# (the economy, agents and missions all work; nothing settles on NEAR). To settle on
# testnet, uncomment these and provide the actors' signing keys: one key file per
# account in CZ_KEYS_DIR (default ~/.contract-zero/keys/v2; the live deployment uses
# keys/v3), or every key in one CZ_KEYS_JSON secret (docs/contract-zero/DEPLOY.md).
# Keys never go in this repository. CZ_WORLD is the game controller (cz-world v2),
# CZ_ASSETS the NEP-245 ledger (cz-assets).
# CZ_WORLD=world2.contract-zero.testnet
# CZ_ASSETS=assets.contract-zero.testnet
# CZ_SERVER_ACCOUNT=server.contract-zero.testnet
# CZ_VANGUARD_ACCOUNT=vanguard.contract-zero.testnet
# CZ_VEX_ACCOUNT=vex.contract-zero.testnet
# CZ_KEYS_DIR=/path/outside/the/repo
# Optional actors, derived from Vanguard's parent account when unset:
# CZ_ASHEN_ACCOUNT=ashen.contract-zero.testnet
# CZ_HALCYON_ACCOUNT=halcyon.contract-zero.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Enables POST /admin/advance (operator clock control). Leave empty in production.
ADMIN_TOKEN=

# NEAR AI Cloud key for the agent planner (cloud.near.ai). Without it, agents run
# their deterministic fallback policies.
NEAR_AI_API_KEY=

# Sign-in and quick trade (docs/contract-zero/AUTH.md). The relayer pays gas for a
# player's own signed setup actions and sponsors new NEAR Auth accounts; its key file
# lives outside the repository.
# CZ_RELAYER_ACCOUNT=cz-relayer-….testnet
# CZ_RELAYER_KEY_FILE=/path/outside/the/repo.json
# NEAR Auth defaults to NEAR's shared TESTNET client (development only; it accepts
# only http://localhost:3000). Production needs your own credentials.
# NEAR_AUTH_CLIENT_ID=
# NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# AUTH_COOKIE_SECURE=1        # behind HTTPS
# Developer sign-in (any test account id, no wallet) for off-chain development.
# Refused automatically whenever settlement (CZ_WORLD) is on.
AUTH_DEV_LOGIN=1

# Strategic planner options (the key is NEAR_AI_API_KEY above):
# NEAR_AI_MODEL=anthropic/claude-haiku-5-5
# PLANNER_EVERY_TICKS=2
# Coalesce event-triggered rounds during this cooldown after each scheduled round.
# PLANNER_COOLDOWN_SECS=120
# PLANNER_MAX_TOKENS=4096

# Official NEAR Intents (1Click) adapter: read-only by default (supported assets,
# dry quotes). A partner key avoids 1Click's extra 25 bps. Live swaps are mainnet,
# real funds: only with explicit approval (NEAR_INTENTS_EXECUTION=mainnet-approved),
# capped per swap in USD. Leave both unset in production.
# ONECLICK_API_KEY=
# NEAR_INTENTS_EXECUTION=
# NEAR_INTENTS_MAX_USD=1

# Mission dialogue rewrite budget and timeout (separate from strategic planning).
# STORY_MAX_TOKENS=4096
# STORY_TIMEOUT_SECS=30
